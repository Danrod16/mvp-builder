</section>

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <h2 id="faq-title">FAQ</h2>
    <div class="faq-list">
      {% for item in faq %}
      <details class="faq">
        <summary><h3>{{ item.q }}</h3></summary>
        <p>{{ item.a }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="final-title">
  <div class="wrap">
    <div class="final">
      <img class="sketch cta-sketch" src="/assets/illustrations/final-cta-calendar.png" alt="">
      <h2 id="final-title">Find out what you could stop doing by hand.</h2>
      <p><a class="btn btn-primary" href="{{ site.cal }}" target="_blank" rel="noopener noreferrer" data-cta="final" data-channel="cal" aria-label="Book a 15-minute call on Cal.com (opens in a new tab)">Book a 15-min call</a></p>
      <p class="or">or <a href="mailto:{{ site.email }}" data-cta="final" data-channel="email">email us</a></p>
